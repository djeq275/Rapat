<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="006-create-meeting-table" author="vibe1">
        <createTable tableName="meeting">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="LONGTEXT"/>
            <column name="material_link" type="VARCHAR(255)"/>
            <column name="start_time" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="end_time" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="division_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="organizer_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="notulensi_link" type="VARCHAR(255)"/>
            <column name="notulensi_text" type="LONGTEXT"/>
            <column name="google_event_id" type="VARCHAR(255)"/>
            <column name="calendar_sync_status" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="calendar_sync_error" type="LONGTEXT"/>
            <column name="calendar_synced_at" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="meeting" baseColumnNames="division_id"
                                  constraintName="fk_meeting_division"
                                  referencedTableName="division" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="meeting" baseColumnNames="organizer_id"
                                  constraintName="fk_meeting_organizer"
                                  referencedTableName="app_user" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="006b-create-meeting-participant-table" author="vibe1">
        <createTable tableName="meeting_participant">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="meeting_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="added_reason" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="meeting_participant" columnNames="meeting_id, user_id"
                              constraintName="uk_meeting_participant"/>
        <addForeignKeyConstraint baseTableName="meeting_participant" baseColumnNames="meeting_id"
                                  constraintName="fk_meeting_participant_meeting"
                                  referencedTableName="meeting" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="meeting_participant" baseColumnNames="user_id"
                                  constraintName="fk_meeting_participant_user"
                                  referencedTableName="app_user" referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>
